{
  "name": "@drifa/format",
  "version": "1.0.0",
  "description": "Drifa's shared Norwegian formatting: money as whole øre, dates, numbers.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drifa-Labs-AS/format.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/*.test.ts\"",
    "verify": "npm run check && npm test && npm run build && git diff --quiet -- dist || (echo 'dist is stale — commit the rebuilt output' && exit 1)"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  }
}
